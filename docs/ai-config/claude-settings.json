{
	"permissions": {
		"deny": [
			"Read(**/.env*)",
			"Read(**/*.jks)",
			"Read(**/*.keystore)",
			"Read(**/*.p12)",
			"Read(**/*.p8)",
			"Read(**/*.pem)",
			"Read(**/*.mobileprovision)",
			"Read(**/google-services.json)",
			"Read(**/GoogleService-Info.plist)",
			"Read(**/*service-account*.json)",
			"Edit(**/.env*)",
			"Edit(**/*.jks)",
			"Edit(**/*.keystore)",
			"Edit(**/*.p12)",
			"Edit(**/*.pem)",
			"Bash(git push origin main:*)",
			"Bash(git push origin HEAD:main:*)",
			"Bash(git push --force:*)",
			"Bash(git commit --no-verify:*)",
			"Bash(gh pr merge:*)",
			"Bash(eas build:*)",
			"Bash(eas submit:*)",
			"Bash(eas update:*)",
			"Bash(eas credentials:*)"
		]
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/docs/ai-config/hooks/git-authorship-guard.sh"
					}
				]
			}
		]
	}
}
